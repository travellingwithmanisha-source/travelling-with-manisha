# ─────────────────────────────────────────────────────────────
# Travelling with Manisha — Environment Variables
# Copy this file to .env.local (dev) and configure the same keys
# in Vercel Project Settings → Environment Variables for prod/preview.
# Never commit the real .env.local / .env file.
# ─────────────────────────────────────────────────────────────

# ── App ─────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# ── Database (Supabase Postgres, used via Prisma) ─────────────
# Pooled connection (used at runtime, via PgBouncer on port 6543)
DATABASE_URL="postgresql://postgres:[PASSWORD]@[PROJECT-REF].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection (used only for migrations, port 5432)
DIRECT_URL="postgresql://postgres:[PASSWORD]@[PROJECT-REF].supabase.co:5432/postgres"

# ── Supabase Auth ──────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key" # server-only, never expose to client

# ── Stripe ──────────────────────────────────────────────────────
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# ── Razorpay ────────────────────────────────────────────────────
RAZORPAY_KEY_ID="rzp_test_..."
RAZORPAY_KEY_SECRET="your-razorpay-key-secret"
RAZORPAY_WEBHOOK_SECRET="your-razorpay-webhook-secret"

# ── Cloudinary ──────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloud-name"
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET="your-unsigned-upload-preset"

# ── Google Maps ─────────────────────────────────────────────────
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="your-google-maps-browser-key"
GOOGLE_MAPS_SERVER_API_KEY="your-google-maps-server-key" # for geocoding/places from API routes

# ── Misc / Ops ──────────────────────────────────────────────────
# Used to sign internal cron/webhook calls if added later
INTERNAL_API_SECRET="generate-a-long-random-string"
